  "components" : {
    "schemas" : {
      "AcknowledgedWarning" : {
        "type" : "object",
        "description" : "The warning the parent acknowledged for an order line",
        "properties" : {
          "acknowledgedAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "context" : {
            "type" : "string",
            "description" : "ADD_TO_CART or CHECKOUT"
          },
          "matches" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SafetyMatch"
            }
          },
          "shownAt" : {
            "type" : "string",
            "format" : "date-time"
          },
          "unverified" : {
            "type" : "boolean"
          }
        },
        "required" : [ "context", "matches", "shownAt", "unverified" ]
      },
      "AddItemRequest" : {
        "type" : "object",
        "description" : "Add a product. Resend with ackToken after the parent confirms a 409 allergen warning.",
        "properties" : {
          "ackToken" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "From the 409 ALLERGEN_WARNING response, after the parent confirmed"
          },
          "productId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "qty" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Defaults to 1",
            "maximum" : 99,
            "minimum" : 1
          }
        },
        "required" : [ "productId" ]
      },
      "AffectedProfile" : {
        "type" : "object",
        "description" : "A child profile affected by a warning",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "label" : {
            "type" : "string"
          }
        },
        "required" : [ "id", "label" ]
      },
      "Allergen" : {
        "type" : "object",
        "description" : "A node in the allergen taxonomy. Matching is by id, never by name or synonym.",
        "properties" : {
          "displayName" : {
            "type" : "string",
            "example" : "Cashew"
          },
          "id" : {
            "type" : "string",
            "example" : "TREE_NUT.CASHEW"
          },
          "parentId" : {
            "type" : "string",
            "description" : "Parent node id; absent for a root such as PEANUT or TREE_NUT",
            "example" : "TREE_NUT"
          },
          "synonyms" : {
            "type" : "array",
            "description" : "Label terms that indicate this allergen; for tagging only",
            "items" : {
              "type" : "string"
            }
          }
        },
