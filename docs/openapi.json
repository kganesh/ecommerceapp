    "/api/v1/carts/me/checkout" : {
      "post" : {
        "operationId" : "checkout",
        "parameters" : [ {
          "description" : "Unique per checkout attempt; reuse it on retries",
          "in" : "header",
          "name" : "Idempotency-Key",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CheckoutRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Order"
                }
              }
            },
            "description" : "Same Idempotency-Key as a placed order: that order"
          },
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Order"
                }
              }
            },
            "description" : "Order placed"
          },
          "402" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Payment declined; no order placed"
          },
          "409" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CheckoutWarning"
                }
              }
            },
            "description" : "Allergen confirmation needed (CHECKOUT_ALLERGEN_WARNING), or PRODUCT_UNAVAILABLE"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Allergen check unavailable; nothing charged"
          }
        },
        "summary" : "Re-check the cart, then charge and place the order",
        "tags" : [ "orders" ]
      }
    },
    "/api/v1/carts/me/items" : {
      "post" : {
        "operationId" : "addCartItem",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/AddItemRequest"
              }
            }
          },
          "required" : true
