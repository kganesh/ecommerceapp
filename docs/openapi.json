        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Cart"
                }
              }
            },
            "description" : "Added"
          },
          "409" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AllergenWarning"
                }
              }
            },
            "description" : "Allergen warning: nothing added; resend with ackToken to confirm"
          },
          "503" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "Allergen check unavailable: nothing added"
          }
        },
        "summary" : "Add a product; 409 with an allergen warning if any child's avoid list matches",
        "tags" : [ "cart" ]
      }
    },
