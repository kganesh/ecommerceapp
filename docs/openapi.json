{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "Nut-allergy safe shopping app. Contract source of truth: docs/openapi.json",
    "title" : "ecommerceapp API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "tags" : [ {
    "description" : "Suggest allergens from a label photo; an admin reviews before saving",
    "name" : "admin-label-extractions"
  }, {
    "description" : "Allergen taxonomy for avoid lists and product tagging",
    "name" : "allergens"
  }, {
    "description" : "Catalog administration; CATALOG_ADMIN only",
    "name" : "admin-products"
  }, {
    "description" : "Who is signed in",
    "name" : "session"
  }, {
    "description" : "Checkout and order history",
    "name" : "orders"
  }, {
    "description" : "Browse and search the catalog",
    "name" : "products"
  }, {
    "description" : "The signed-in parent's cart; every add is allergen-checked",
    "name" : "cart"
  }, {
    "description" : "Child profiles and their avoid lists",
    "name" : "profiles"
  }, {
    "description" : "Build and runtime information",
    "name" : "meta"
  } ],
